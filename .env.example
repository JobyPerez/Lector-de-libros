# Combinaciones de entorno y despliegue:
# servidor - producción: pm2 y código compilado.
# servidor - desarrollo: pm2 y código compilado en caliente.
# local - producción: no es posible.
# local - desarrollo: npm y código compilado en caliente.
ENTORNO=local # servidor o local
DESPLIEGUE=desarrollo # producción o desarrollo

API_PORT=3000
WEB_ORIGIN=http://localhost:5173
PASSWORD_RESET_URL_BASE=http://localhost:5173/reset-password

JWT_ACCESS_SECRET=replace-with-a-long-random-string-for-access-token-signing
JWT_REFRESH_SECRET=replace-with-a-long-random-string-for-refresh-token-signing

# Base de datos Oracle
ORACLE_USER=replace-with-oracle-user
ORACLE_PASSWORD=replace-with-oracle-password
ORACLE_CONNECT_STRING=replace-with-wallet-service-name
ORACLE_WALLET_LOCATION=./wallet
ORACLE_WALLET_PASSWORD=replace-with-wallet-password

# API de las voces de Deepgram para la generación de audio a partir de texto
DEEPGRAM_API_KEY=replace-with-deepgram-api-key
# Voz española por defecto para usuarios que aún no tengan una preferencia guardada.
# Permitidas: aura-2-nestor-es, aura-2-carina-es, aura-2-alvaro-es, aura-2-diana-es, aura-2-agustina-es, aura-2-silvia-es
DEEPGRAM_TTS_MODEL=aura-2-nestor-es
# Voz italiana por defecto. El catálogo completo se expone en GET /tts/config.
DEEPGRAM_TTS_MODEL_IT=aura-2-livia-it

# IA para resúmenes y peticiones. Permitidos: nemotron-3-ultra-free, deepseek-v4-flash-free
OPENCODE_GO_API_KEY=replace-with-opencode-go-api-key
OPENCODE_MODEL=deepseek-v4-flash-free
# El OCR requiere el modelo multimodal MiMo.
OPENCODE_OCR_MODEL=mimo-v2.5-free

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=El conejo lector

VITE_API_URL=http://localhost:3000
VITE_APP_BASE_PATH=/
